{
  "manifest_version": 3,
  "name": "Summerer",
  "short_name": "Summerer",
  "description": "AI 채팅을 요약해 Summerer 블로그에 타임라인으로 저장합니다.",
  "version": "0.2.2",
  "key": "",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Summerer"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": [
    "storage",
    "identity",
    "tabs"
  ],
  "host_permissions": [
    "https://summerer.vercel.app/*",
    "https://caveduck.io/*",
    "https://*.caveduck.io/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://caveduck.io/*",
        "https://*.caveduck.io/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}